{
  "name": "pokehelper-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ${OPENAPI_SCHEMA:-../backend/openapi.json} -o src/types/api.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- src/types/api.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "^7.9.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
