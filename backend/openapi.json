  "info": {
    "description": "포켓몬 챔피언스 파티 구축 + 선출 판단 보조 API",
    "title": "pokeHelper API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/calc/ev-tune": {
      "post": {
        "description": "제약조건을 만족하는 노력치 배분을 역산한다. 해가 없으면 `feasible: false` 와 함께 무엇이 충돌하는지, 무엇을 포기하면 되는지를 돌려준다. 오류가 아니라 유효한 결과다.",
        "operationId": "ev_tune_endpoint_api_v1_calc_ev_tune_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvTuneRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/EvTuneSolution"
                    },
                    {
                      "$ref": "#/components/schemas/EvTuneInfeasible"
                    }
                  ],
                  "title": "Response Ev Tune Endpoint Api V1 Calc Ev Tune Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "노력치 미세조정",
        "tags": [
          "calc"
        ]
      }
    },
    "/api/v1/meta/pokemon/{pokemon_id}": {
      "get": {
        "description": "기술·도구·특성·성격·파트너 채용률과 노력치 배분(HABCDS 표기). 한글명 매핑이 없는 선택지는 `name_ko` 가 null 이고 `unmapped` 에 개수가 잡힌다 — 영문 id 를 한글명 자리에 넣지 않는다.",
        "operationId": "pokemon_endpoint_api_v1_meta_pokemon__pokemon_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "pokemon_id",
            "required": true,
            "schema": {
              "title": "Pokemon Id",
              "type": "string"
            }
          },
          {
            "description": "대전 포맷. 이 서비스는 싱글 기준이다 (CLAUDE.md 8-1).",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "Singles",
              "description": "대전 포맷. 이 서비스는 싱글 기준이다 (CLAUDE.md 8-1).",
              "enum": [
                "Singles",
                "Doubles"
              ],
              "title": "Format",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PokemonMetaOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "포켓몬 채용률 상세",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/meta/usage": {
      "get": {
        "description": "활성 스냅샷의 포켓몬 사용 순위. **사용률 퍼센트는 출처가 주지 않으므로 `usage_rate` 는 거의 항상 null 이고 0 으로 대체하지 않는다.** 모든 응답에 출처 표기와 수집 시각이 함께 나간다.",
        "operationId": "usage_endpoint_api_v1_meta_usage_get",
        "parameters": [
          {
            "description": "대전 포맷. 이 서비스는 싱글 기준이다 (CLAUDE.md 8-1).",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "Singles",
              "description": "대전 포맷. 이 서비스는 싱글 기준이다 (CLAUDE.md 8-1).",
              "enum": [
                "Singles",
                "Doubles"
              ],
              "title": "Format",
              "type": "string"
            }
          },
          {
            "description": "돌려줄 엔트리 수. 상한 60 — 덤프 방지 장치다.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 30,
              "description": "돌려줄 엔트리 수. 상한 60 — 덤프 방지 장치다.",
              "maximum": 60,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageListOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "사용 순위표",
        "tags": [
          "meta"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
