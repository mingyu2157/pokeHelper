# `cp terraform.tfvars.example terraform.tfvars` 후 채운다.
# terraform.tfvars 는 커밋하지 않는다(.gitignore 의 *.tfvars).
#
# ★ 아래 셋은 **전부 필수다** (2026-11-23 부터). 쓰는 자원이 생겼다 —
#   dns.tf·alb.tf 가 도메인을, observability.tf 가 알람 주소를 참조한다.
#   한동안 선택값이었던 이력은 variables.tf 의 각 description 에 남겨뒀다.

# ── 도메인 (ALB 의 ACM 인증서용) ─────────────────────────────
# ★ 등록은 Terraform 으로 하지 않는다 — 1년 약정이고 destroy 로 못 되돌리며,
#   등록자 연락처(개인정보)가 들어간다. 콘솔에서 등록한 뒤 여기에 적는다.
#   절차는 README 3장.
#
# domain_name: 호스트명만. 스킴(https://)·경로·끝 점을 붙이면 validation 이 막는다.
# hosted_zone_id: 등록 시 Route 53 이 **자동 생성한** 존의 ID. 직접 만들지 않는다.
#   Route 53 → Hosted zones → 해당 존 → Hosted zone ID
domain_name    = "example.com"
hosted_zone_id = "Z00000000000000000000"

# ── 청구 알람 ────────────────────────────────────────────────
# apply 후 구독 확인 메일이 한 번 온다. 확인해야 알람이 온다.
alarm_email = "you@example.com"

# ── 이미지 태그 (2026-11-24 추가, ecs.tf 가 쓴다) ────────────
# ★ 기본값이 없다. 없으면 plan 이 멈춰 서서 값을 묻는다.
#   `latest` 같은 기본값을 받아주면 **무엇이 떠 있는지 git 에서 되짚을 수 없다.**
#
#   값 얻는 법:  git rev-parse --short=12 HEAD
#   그 SHA 의 이미지가 ECR 에 올라가 있어야 한다 (README 5-B).
#   `-dirty` 가 붙은 태그는 validation 이 거부한다 — 어떤 커밋도 설명하지 못한다.
image_tag = "000000000000"

# ── 기본값으로 충분하지만 바꾸려면 ───────────────────────────
# region             = "ap-northeast-2"
# monthly_budget_usd = 150
