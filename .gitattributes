# 저장소에는 항상 LF로 저장하고, 체크아웃할 때도 LF로 펼친다.
# 이유: 컨테이너(리눅스)에서 실행되는 파일이 CRLF면 깨진다.
#   예) /entrypoint.sh: line 1: #!/bin/sh^M: bad interpreter
* text=auto eol=lf

# Windows 전용 스크립트만 CRLF를 유지한다.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리는 변환하지 않는다.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# 린터 diff 노이즈를 줄인다 (생성물).
package-lock.json -diff
uv.lock -diff
