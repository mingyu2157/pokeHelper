# pokeHelper 로컬 개발 환경변수 예시
# 사용법: cp .env.example .env  (.env 는 커밋하지 않는다)

# ---- PostgreSQL ----
POSTGRES_USER=champs
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=champs
# 컨테이너 간 통신이므로 host 는 서비스명(db). 호스트에서 붙을 땐 localhost:5432
DATABASE_URL=postgresql+asyncpg://champs:devpassword@db:5432/champs

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- 애플리케이션 ----
APP_ENV=development
LOG_LEVEL=INFO
# 프론트 개발 서버 오리진. 쉼표로 여러 개 지정 가능
CORS_ORIGINS=http://localhost:3000

# ---- LLM (Phase 4에서 사용. 백엔드에서만 호출한다) ----
# 값을 채운 .env 는 절대 커밋하지 않는다
ANTHROPIC_API_KEY=

# ---- 프론트엔드 ----
# 브라우저에서 접근하는 주소라 localhost 가 맞다 (컨테이너명 아님)
NEXT_PUBLIC_API_URL=http://localhost:8000
