# pokeHelper 로컬 개발 환경변수 예시
# 사용법: cp .env.example .env  (.env 는 커밋하지 않는다)

# ---- PostgreSQL ----
# ★ 부트스트랩 계정. postgres 이미지가 만드는 슈퍼유저다 (ADR-015).
#   역할 생성(init_roles.sh)과 긴급 상황에만 쓴다. 애플리케이션은 쓰지 않는다.
POSTGRES_USER=champs
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=champs

# ---- DB 계정 분리 (ADR-015) ----
# 세 계정의 비밀번호. init_roles.sh 가 이 값으로 역할을 만들고 갱신한다.
# 운영에서는 반드시 다른 값으로 바꾼다.
CHAMPS_MIGRATE_PASSWORD=devmigrate
CHAMPS_APP_PASSWORD=devapp
CHAMPS_READ_PASSWORD=devread

# 앱 런타임 — DML 만. DDL 불가.
# 컨테이너 간 통신이므로 host 는 서비스명(db). 호스트에서 붙을 땐 localhost:5432
DATABASE_URL=postgresql+asyncpg://champs_app:devapp@db:5432/champs
# 마이그레이션 전용 — DDL. alembic 만 읽는다.
MIGRATION_DATABASE_URL=postgresql+asyncpg://champs_migrate:devmigrate@db:5432/champs
# 읽기 전용 — 디버깅·분석, 그리고 backup.sh.
# 스크립트는 libpq 환경변수를 쓰므로 Settings 에는 넣지 않는다.
READONLY_DATABASE_URL=postgresql://champs_read:devread@db:5432/champs

# ---- 백업 / 복구 리허설 (ADR-014) ----
# 백업 산출물 디렉토리. 컨테이너 안 경로다 (호스트의 backend/backups/ 에 보인다).
# 실데이터가 들어가므로 .gitignore 로 제외한다.
BACKUP_DIR=/app/backups
# 보존 기간. 이보다 오래된 덤프는 backup.sh 가 삭제한다.
# 라이선스상 영구 미러가 금지돼 있어(CLAUDE.md 8-2) 백업도 무한 누적하지 않는다.
BACKUP_RETENTION_DAYS=7
# 복구 리허설 전용 DB. 개발 DB(db)와 볼륨이 분리돼 있다.
# `docker compose --profile rehearsal up -d db-rehearsal` 로 띄운다.
REHEARSAL_DATABASE_URL=postgresql+asyncpg://champs:devpassword@db-rehearsal:5432/champs

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- 애플리케이션 ----
APP_ENV=development
LOG_LEVEL=INFO
# 프론트 개발 서버 오리진. 쉼표로 여러 개 지정 가능
CORS_ORIGINS=http://localhost:3000

# ---- LLM (Phase 4에서 사용. 백엔드에서만 호출한다) ----
# 값을 채운 .env 는 절대 커밋하지 않는다
ANTHROPIC_API_KEY=

# ---- 관측성 (profile: observability, ADR-016) ----
# Grafana 로그인. 로컬 전용이고 포트도 로컬에만 열린다.
# 운영에서는 절대 이 값을 쓰지 않는다 (ADR-016 포기한 것).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# redis-exporter 는 위의 REDIS_URL 을 그대로 쓴다 (db 인덱스 /0 포함해도 동작함, 실측 확인).
# postgres-exporter 는 CHAMPS_READ_PASSWORD 로 champs_read 계정에 붙는다.

# ---- 프론트엔드 ----
# 브라우저에서 접근하는 주소라 localhost 가 맞다 (컨테이너명 아님)
NEXT_PUBLIC_API_URL=http://localhost:8000
